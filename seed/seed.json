								}
							]
						},
						{
							"_type": "block",
							"_key": "a2",
							"style": "normal",
							"markDefs": [],
							"children": [
								{
									"_type": "span",
									"_key": "a3",
									"text": "Granted, this information rarely takes upon first processing. Years of intense searching led us at the AAA to this point. We have displayed this knowledge then in a non-threatening online publication so as to invite all to our non-wooden table of freedom at their own pace.",
									"marks": []
								}
							]
						}
					]
				},
				{
					"type": "content",
					"title": "Watch the Documentary",
					"content": [
						{
							"_type": "block",
							"_key": "d0",
							"style": "normal",
							"markDefs": [
								{
									"_type": "link",
									"_key": "l2",
									"href": "https://www.amazon.com/gp/product/B001DZOC6Y?tag=0713m611l-20"
								}
							],
							"children": [
								{
									"_type": "span",
									"_key": "d1",
									"text": "M. Night Shyamalan's documentary (\"",
									"marks": []
								},
								{
									"_type": "span",
									"_key": "d2",
									"text": "The Happening",
									"marks": [
										"l2"
									]
								},
								{
									"_type": "span",
									"_key": "d3",
									"text": "\") about trees was labeled as a \"thriller\" by the MPAA, but make no mistake: the events in this film are truthy. ",
									"marks": []
								},
								{
									"_type": "span",
									"_key": "d4",
									"text": "Watch it now!",
									"marks": [
										"strong",
										"l2"
									]
								}
							]
						}
					]
				}
			]
		}
