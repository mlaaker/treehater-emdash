{
	"$schema": "node_modules/wrangler/config-schema.json",
	// House of Laaker. Pinned so no deploy can land in the Civilian Power account.
	"account_id": "8a497e94551222093a598d3fa0c30190",
	"name": "treehater-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			// Fresh database for the exporter import (2026-10-29). The April trial
			// import stays untouched in treehater-emdash-db (098cfed8-…) as a backup.
			"database_name": "treehater-emdash-db-v2",
			"database_id": "586f5ffa-d502-4203-8388-ff4c542853ca",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "treehater-emdash-media",
		},
	],
	// Sessions namespace created by the first deploy on 2026-04-02; reuse it.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "5fa5a3110e3d4c63905da44e5bf0fc2e",
		},
	],
	// Custom domains (www and the apex, at cutover) are attached in the
	// dashboard, not here, so a deploy never moves DNS.
	"workers_dev": true,
	"observability": {
		"enabled": true,
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans.
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
