{
	"$schema": "node_modules/wrangler/config-schema.json",
	// House of Laaker. Pinned so no deploy can land in the Civilian Power account.
	"account_id": "8a497e94551222093a598d3fa0c30190",
	"name": "treehater-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "treehater-emdash-db",
			"database_id": "098cfed8-2910-4957-9a9c-23076a2e38d1",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "treehater-emdash-media",
		},
	],
	// Sessions namespace created by the first deploy on 2026-04-02; reuse it.
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "5fa5a3110e3d4c63905da44e5bf0fc2e",
		},
	],
	// Custom domains (staging.treehater.com for the admin/import, then www and
	// the apex at cutover) are attached in the dashboard, not here, so a deploy
	// never moves DNS.
	"workers_dev": true,
	"observability": {
		"enabled": true,
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans.
	"worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
