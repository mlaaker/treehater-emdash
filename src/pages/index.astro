---
/**
 * Home page (latest posts, WordPress's "Your latest posts" front page) and
 * search results, which WordPress served from /?s=term.
 */
import { getEmDashCollection, getSiteSettings, search } from "emdash";
import Base from "../layouts/Base.astro";
import Archive from "../components/tt/Archive.astro";
import { loadPostPage } from "../lib/tt";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const query = Astro.url.searchParams.get("s")?.trim() ?? "";
const page = 1;

let archive;
if (query) {
	const { items } = await search(query, { collections: ["posts"], limit: 100 });
	// Search returns ranked ids; render the matching posts in full, as WordPress did.
	const rank = new Map(items.map((item, i) => [item.id, i]));
	const { entries } = await getEmDashCollection("posts", { limit: 1000 });
	const matches = entries
		.filter((p) => rank.has(p.data.id))
		.sort((a, b) => rank.get(a.data.id)! - rank.get(b.data.id)!);
	archive = { posts: matches, totalPages: 1, total: matches.length };
} else {
	const result = await loadPostPage(page);
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
	archive = result;
}

const escapeHtml = (s: string) =>
	s.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;");
const subtitle = query
	? archive.total === 0
		? "We could not find any results for your search. You can give it another try through the search form below."
		: `We found ${archive.total} ${archive.total === 1 ? "result" : "results"} for your search.`
	: undefined;
---

<Base
	title={query ? `Search Results for “${query}”` : siteTitle}
	bodyClass={query ? "search search-results" : "home blog"}
	robots={query ? "noindex, follow" : undefined}
	searchQuery={query}
>
	<Archive
		posts={archive.posts}
		page={page}
		totalPages={archive.totalPages}
		basePath="/"
		headingLabel={query ? "Search:" : undefined}
		heading={query ? `&ldquo;${escapeHtml(query)}&rdquo;` : undefined}
		subtitle={subtitle}
	/>
</Base>
