---
/**
 * Twenty Twenty's page shell (header, search and menu modals, footer
 * widgets, credits), with the markup and classes the WordPress theme
 * rendered, so its stylesheet in public/twentytwenty/ applies unchanged.
 */
import {
	getMenuWithCacheHint,
	getSiteSettingsWithCacheHint,
	getWidgetAreaWithCacheHint,
} from "emdash";
import { EmDashHead, EmDashBodyStart, EmDashBodyEnd, PortableText } from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import Icon from "../components/tt/Icon.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
	/** Twenty Twenty body classes for this template, e.g. "singular". */
	bodyClass?: string;
	/** Prefills the search modal on search results. */
	searchQuery?: string;
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
	bodyClass = "",
	searchQuery = "",
} = Astro.props;

const [settingsResult, menuResult, footerResult] = await Promise.all([
	getSiteSettingsWithCacheHint(),
	getMenuWithCacheHint("primary"),
	getWidgetAreaWithCacheHint("footer"),
]);
if (Astro.cache?.enabled) {
	Astro.cache.set(settingsResult.cacheHint);
	Astro.cache.set(menuResult.cacheHint);
	Astro.cache.set(footerResult.cacheHint);
}

const { siteTitle, siteTagline, siteLogo } = resolveBlogSiteIdentity(settingsResult.data);
// WordPress titled pages "Post title – Site title" and the home page (and its
// /page/2/) "Site title – Tagline".
const isFrontTitle = title === siteTitle || title.startsWith(`${siteTitle} – `);
const fullTitle = isFrontTitle ? `${title} – ${siteTagline}` : `${title} – ${siteTitle}`;
const logoUrl = siteLogo?.url ?? "/_emdash/api/media/file/aaa-logo.png";
const faviconUrl = settingsResult.data?.favicon?.url ?? "/_emdash/api/media/file/favicon.png";

const menuItems = menuResult.data?.items ?? [];
const footerWidgets = (footerResult.data?.widgets ?? []).filter(
	(w) => w.type === "content" && w.content?.length,
);

const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical,
	image,
	content,
	seo: { ogImage: image, robots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isHome = Astro.url.pathname === "/";
const year = new Date().getFullYear();
const classes = [
	bodyClass,
	"custom-background wp-custom-logo wp-embed-responsive",
	"enable-search-modal showing-comments show-avatars footer-top-visible reduced-spacing",
]
	.filter(Boolean)
	.join(" ");
---

<!doctype html>
<html class="no-js" lang="en-US">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<script is:inline>
			document.documentElement.className = document.documentElement.className.replace("no-js", "js");
		</script>
		<title>{fullTitle}</title>
		<EmDashHead page={pageCtx} />
		<link rel="stylesheet" href="/twentytwenty/style.css" />
		<link rel="stylesheet" href="/twentytwenty/block-library.css" />
		<link rel="stylesheet" href="/twentytwenty/accent.css" />
		<link rel="stylesheet" href="/twentytwenty/emdash.css" />
		<link rel="icon" href={faviconUrl} sizes="32x32" />
		<link rel="apple-touch-icon" href={faviconUrl} />
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} » Feed`} href="/feed/" />
		<script is:inline src="/twentytwenty/assets/js/index.js" defer></script>
	</head>
	<body class={classes}>
		<EmDashBodyStart page={pageCtx} />
		<a class="skip-link screen-reader-text" href="#site-content">Skip to the content</a>
		<header id="site-header" class="header-footer-group">
			<div class="header-inner section-inner">
				<div class="header-titles-wrapper">
					<button
						class="toggle search-toggle mobile-search-toggle"
						data-toggle-target=".search-modal"
						data-toggle-body-class="showing-search-modal"
						data-set-focus=".search-modal .search-field"
						aria-expanded="false"
					>
						<span class="toggle-inner">
							<span class="toggle-icon"><Icon name="search" /></span>
							<span class="toggle-text">Search</span>
						</span>
					</button>

					<div class="header-titles">
						{
							isHome ? (
								<h1 class="site-logo">
									<a href="/" class="custom-logo-link" rel="home" aria-current="page">
										<img width="200" height="200" style="height: 200px;" src={logoUrl} class="custom-logo" alt={siteTitle} decoding="async" fetchpriority="high" />
									</a>
									<span class="screen-reader-text">{siteTitle}</span>
								</h1>
							) : (
								<div class="site-logo faux-heading">
									<a href="/" class="custom-logo-link" rel="home">
										<img width="200" height="200" style="height: 200px;" src={logoUrl} class="custom-logo" alt={siteTitle} decoding="async" />
									</a>
									<span class="screen-reader-text">{siteTitle}</span>
								</div>
							)
						}
						<div class="site-description">{siteTagline}</div>
					</div>

					<button
						class="toggle nav-toggle mobile-nav-toggle"
						data-toggle-target=".menu-modal"
						data-toggle-body-class="showing-menu-modal"
						aria-expanded="false"
						data-set-focus=".close-nav-toggle"
					>
						<span class="toggle-inner">
							<span class="toggle-icon"><Icon name="ellipsis" /></span>
							<span class="toggle-text">Menu</span>
						</span>
					</button>
				</div>

				<div class="header-navigation-wrapper">
					<nav class="primary-menu-wrapper" aria-label="Horizontal">
						<ul class="primary-menu reset-list-style">
							{
								menuItems.map((item) => (
									<li class="page_item">
										<a href={item.url} target={item.target}>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>

					<div class="header-toggles hide-no-js">
						<div class="toggle-wrapper search-toggle-wrapper">
							<button
								class="toggle search-toggle desktop-search-toggle"
								data-toggle-target=".search-modal"
								data-toggle-body-class="showing-search-modal"
								data-set-focus=".search-modal .search-field"
								aria-expanded="false"
							>
								<span class="toggle-inner">
									<Icon name="search" />
									<span class="toggle-text">Search</span>
								</span>
							</button>
						</div>
					</div>
				</div>
			</div>

			<div class="search-modal cover-modal header-footer-group" data-modal-target-string=".search-modal" role="dialog" aria-modal="true" aria-label="Search">
				<div class="search-modal-inner modal-inner">
					<div class="section-inner">
						<form role="search" aria-label="Search for:" method="get" class="search-form" action="/">
							<label for="search-form-1">
								<span class="screen-reader-text">Search for:</span>
								<input type="search" id="search-form-1" class="search-field" placeholder="Search &hellip;" value={searchQuery} name="s" />
							</label>
							<input type="submit" class="search-submit" value="Search" />
						</form>
						<button
							class="toggle search-untoggle close-search-toggle fill-children-current-color"
							data-toggle-target=".search-modal"
							data-toggle-body-class="showing-search-modal"
							data-set-focus=".search-modal .search-field"
						>
							<span class="screen-reader-text">Close search</span>
							<Icon name="close" />
						</button>
					</div>
				</div>
			</div>
		</header>

		<div class="menu-modal cover-modal header-footer-group" data-modal-target-string=".menu-modal">
			<div class="menu-modal-inner modal-inner">
				<div class="menu-wrapper section-inner">
					<div class="menu-top">
						<button
							class="toggle close-nav-toggle fill-children-current-color"
							data-toggle-target=".menu-modal"
							data-toggle-body-class="showing-menu-modal"
							data-set-focus=".menu-modal"
						>
							<span class="toggle-text">Close Menu</span>
							<Icon name="close" />
						</button>
						<nav class="mobile-menu" aria-label="Mobile">
							<ul class="modal-menu reset-list-style">
								{
									menuItems.map((item) => (
										<li class="page_item">
											<div class="ancestor-wrapper">
												<a href={item.url} target={item.target}>
													{item.label}
												</a>
											</div>
										</li>
									))
								}
							</ul>
						</nav>
					</div>
					<div class="menu-bottom"></div>
				</div>
			</div>
		</div>

		<main id="site-content">
			<slot />
		</main>

		{
			footerWidgets.length > 0 && (
				<div class="footer-nav-widgets-wrapper header-footer-group">
					<div class="footer-inner section-inner">
						<aside class="footer-widgets-outer-wrapper">
							<div class="footer-widgets-wrapper">
								<div class="footer-widgets column-one grid-item">
									{footerWidgets.map((widget) => (
										<div class="widget widget_text">
											<div class="widget-content">
												{widget.title && <h2 class="widget-title subheading heading-size-3">{widget.title}</h2>}
												<div class="textwidget">
													<PortableText value={widget.content!} />
												</div>
											</div>
										</div>
									))}
								</div>
								{/* WordPress's second column held only the analytics snippet; kept so the grid splits the same. */}
								<div class="footer-widgets column-two grid-item"></div>
							</div>
						</aside>
					</div>
				</div>
			)
		}

		<footer id="site-footer" class="header-footer-group">
			<div class="section-inner">
				<div class="footer-credits">
					<p class="footer-copyright">
						&copy; {year} <a href="/">{siteTitle}</a>
					</p>
					<p class="powered-by-wordpress">
						<a href="https://emdashcms.com/">Powered by EmDash</a>
					</p>
				</div>
				<a class="to-the-top" href="#site-header">
					<span class="to-the-top-long">To the top <span class="arrow" aria-hidden="true">&uarr;</span></span>
					<span class="to-the-top-short">Up <span class="arrow" aria-hidden="true">&uarr;</span></span>
				</a>
			</div>
		</footer>

		<EmDashBodyEnd page={pageCtx} />
		<!-- Cloudflare Web Analytics, carried over from the WordPress footer widget -->
		<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "240f173d442f412ab3d7843da0849d5d"}'></script>
	</body>
</html>
